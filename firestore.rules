rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // Global Hardened Primitives
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isVerifiedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'An.Tr1p13xxx@gmail.com';
    }

    function isAdmin() {
      return isVerifiedAdminEmail() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isWorkspaceOwner(workspaceId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function isWorkspaceOwnerOrBatch(workspaceId) {
      return (
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
      ) || (
        existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid
      );
    }

    function groupExistsInWorkspace(workspaceId, groupId) {
      return exists(/databases/$(database)/documents/workspaces/$(workspaceId)/groups/$(groupId)) ||
        existsAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/groups/$(groupId));
    }

    // =========================================================
    // Validation Blueprints
    // =========================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspace(data, workspaceId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'name', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == workspaceId &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidShortcutGroup(data, groupId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'color', 'icon', 'order', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'name', 'description', 'color', 'icon', 'order', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == groupId &&
        isValidId(data.ownerId) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 240)) &&
        data.color in ['indigo', 'blue', 'emerald', 'amber', 'rose', 'purple', 'cyan', 'slate'] &&
        data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 250000 &&
        data.order is number && data.order >= 0 && data.order <= 10000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidShortcutItem(data, shortcutId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'url', 'type', 'groupId', 'iconType', 'isPinned', 'clickCount', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'ownerId', 'title', 'url', 'type', 'groupId', 'description', 'iconType', 'iconValue', 'color', 'isPinned', 'clickCount', 'lastOpened', 'tags', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.id == shortcutId &&
        isValidId(data.ownerId) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
        data.url is string && data.url.size() >= 1 && data.url.size() <= 1000 &&
        data.type in ['web', 'directory', 'protocol', 'file'] &&
        isValidId(data.groupId) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.iconType in ['preset', 'favicon', 'custom', 'drive'] &&
        (!('iconValue' in data) || (data.iconValue is string && data.iconValue.size() <= 250000)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 30)) &&
        data.isPinned is bool &&
        data.clickCount is number && data.clickCount >= 0 && data.clickCount <= 100000000 &&
        (!('lastOpened' in data) || (data.lastOpened is number && data.lastOpened >= 0)) &&
        (!('tags' in data) || (
          data.tags is list &&
          data.tags.size() <= 10 &&
          (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        )) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceSettings(data) {
      return data.keys().hasAll(['ownerId', 'cardDensity', 'viewMode', 'theme', 'jarvisIntroEnabled', 'jarvisAudioEnabled', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'cardDensity', 'viewMode', 'theme', 'uiStyle', 'sortBy', 'jarvisIntroEnabled', 'jarvisAudioEnabled', 'customLogoSrc', 'customLogoFit', 'updatedAt']) &&
        isValidId(data.ownerId) &&
        data.cardDensity in ['small', 'medium', 'large'] &&
        data.viewMode in ['grid', 'list', 'sections', 'orbit'] &&
        data.theme in ['light', 'dark'] &&
        (!('uiStyle' in data) || data.uiStyle in ['claymorphism', 'classic']) &&
        (!('sortBy' in data) || data.sortBy in ['clicks', 'recent', 'name']) &&
        data.jarvisIntroEnabled is bool &&
        data.jarvisAudioEnabled is bool &&
        (!('customLogoSrc' in data) || (data.customLogoSrc is string && data.customLogoSrc.size() <= 250000)) &&
        (!('customLogoFit' in data) || data.customLogoFit in ['cover', 'contain']) &&
        data.updatedAt is timestamp;
    }

    // =========================================================
    // Collection: /admins/{adminId} (Read-only for verified self)
    // =========================================================
    match /admins/{adminId} {
      allow get: if isOwner(adminId);
      allow list, create, update, delete: if false;
    }

    // =========================================================
    // Collection: /users/{userId}/private/profile (PII Isolated)
    // =========================================================
    match /users/{userId}/private/profile {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        (isAdmin() || (
          isOwner(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'updatedAt'])
        )) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());
    }

    // =========================================================
    // Collection: /workspaces/{workspaceId}
    // =========================================================
    match /workspaces/{workspaceId} {
      allow get: if isVerifiedUser() && isValidId(workspaceId) && (
        isAdmin() ||
        (resource == null && workspaceId == request.auth.uid) ||
        (resource != null && existing().ownerId == request.auth.uid)
      );
      allow list: if isVerifiedUser() && (existing().ownerId == request.auth.uid || isVerifiedAdminEmail());
      allow create: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming(), workspaceId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(workspaceId) &&
        isValidWorkspace(incoming(), workspaceId) &&
        (isAdmin() || (
          existing().ownerId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
        )) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isVerifiedUser() && isValidId(workspaceId) && (existing().ownerId == request.auth.uid || isAdmin());

      // -------------------------------------------------------
      // Subcollection: /workspaces/{workspaceId}/groups/{groupId}
      // -------------------------------------------------------
      match /groups/{groupId} {
        allow get: if isVerifiedUser() && isValidId(workspaceId) && isValidId(groupId) && (
          isAdmin() ||
          (resource == null && workspaceId == request.auth.uid) ||
          (resource != null && existing().ownerId == request.auth.uid)
        );
        allow list: if isVerifiedUser() && (existing().ownerId == request.auth.uid || isVerifiedAdminEmail());
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(groupId) &&
          isValidShortcutGroup(incoming(), groupId) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwnerOrBatch(workspaceId);
        allow update: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(groupId) &&
          isValidShortcutGroup(incoming(), groupId) &&
          (isAdmin() || (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'color', 'icon', 'order', 'updatedAt'])
          )) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwner(workspaceId);
        allow delete: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(groupId) &&
          (isAdmin() || (existing().ownerId == request.auth.uid && isWorkspaceOwner(workspaceId)));
      }

      // -------------------------------------------------------
      // Subcollection: /workspaces/{workspaceId}/shortcuts/{shortcutId}
      // -------------------------------------------------------
      match /shortcuts/{shortcutId} {
        allow get: if isVerifiedUser() && isValidId(workspaceId) && isValidId(shortcutId) && (
          isAdmin() ||
          (resource == null && workspaceId == request.auth.uid) ||
          (resource != null && existing().ownerId == request.auth.uid)
        );
        allow list: if isVerifiedUser() && (existing().ownerId == request.auth.uid || isVerifiedAdminEmail());
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(shortcutId) &&
          isValidShortcutItem(incoming(), shortcutId) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwnerOrBatch(workspaceId) &&
          groupExistsInWorkspace(workspaceId, incoming().groupId);
        allow update: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(shortcutId) &&
          isValidShortcutItem(incoming(), shortcutId) &&
          (isAdmin() || (
            existing().ownerId == request.auth.uid && (
              // Action 1: Launch / Click telemetry update
              (incoming().diff(existing()).affectedKeys().hasOnly(['clickCount', 'lastOpened', 'updatedAt']) && incoming().clickCount >= existing().clickCount) ||
              // Action 2: Pin / Unpin toggle
              incoming().diff(existing()).affectedKeys().hasOnly(['isPinned', 'updatedAt']) ||
              // Action 3: Full Shortcut Edit / Group Reassign
              incoming().diff(existing()).affectedKeys().hasOnly(['title', 'url', 'type', 'groupId', 'description', 'iconType', 'iconValue', 'color', 'isPinned', 'tags', 'updatedAt'])
            )
          )) &&
          incoming().id == existing().id &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwner(workspaceId) &&
          groupExistsInWorkspace(workspaceId, incoming().groupId);
        allow delete: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidId(shortcutId) &&
          (isAdmin() || (existing().ownerId == request.auth.uid && isWorkspaceOwner(workspaceId)));
      }

      // -------------------------------------------------------
      // Subcollection: /workspaces/{workspaceId}/settings/config
      // -------------------------------------------------------
      match /settings/config {
        allow get: if isVerifiedUser() && isValidId(workspaceId) && (
          isAdmin() ||
          (resource == null && workspaceId == request.auth.uid) ||
          (resource != null && existing().ownerId == request.auth.uid)
        );
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidWorkspaceSettings(incoming()) &&
          incoming().ownerId == request.auth.uid &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwnerOrBatch(workspaceId);
        allow update: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          isValidWorkspaceSettings(incoming()) &&
          (isAdmin() || (
            existing().ownerId == request.auth.uid && (
              // Action 1: Display preferences (density, viewMode, theme, uiStyle, sortBy, jarvis)
              incoming().diff(existing()).affectedKeys().hasOnly(['cardDensity', 'viewMode', 'theme', 'uiStyle', 'sortBy', 'jarvisIntroEnabled', 'jarvisAudioEnabled', 'updatedAt']) ||
              // Action 2: Custom Brand Logo update
              incoming().diff(existing()).affectedKeys().hasOnly(['customLogoSrc', 'customLogoFit', 'updatedAt'])
            )
          )) &&
          incoming().ownerId == existing().ownerId &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwner(workspaceId);
        allow delete: if isVerifiedUser() &&
          isValidId(workspaceId) &&
          (isAdmin() || (existing().ownerId == request.auth.uid && isWorkspaceOwner(workspaceId)));
      }
    }
  }
}
